/sitemap.xml
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/sitemap.txt
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=3600
  Content-Type: text/plain; charset=utf-8

/*
  Strict-Transport-Security: max-age=31536000

# JS/CSS: mereu proaspete — browserul revalideaza cu ETag (304 ieftin),
# deci dupa fiecare deploy utilizatorii primesc codul nou fara hard-refresh.
/assets/*.js
  Cache-Control: no-cache

/assets/*.css
  Cache-Control: no-cache

/assets/js/*.js
  Cache-Control: no-cache

/assets/css/*.css
  Cache-Control: no-cache

# Imagini/fonturi: cache lung (nu se schimba la deploy)
/assets/img/*
  Cache-Control: public, max-age=2592000, immutable

# Coperțile: numele se poate refolosi (adminul înlocuiește imaginea), deci
# o săptămână — propagarea unei înlocuiri rămâne rezonabil de rapidă.
/covers/*
  Cache-Control: public, max-age=604800
