{
  "name": "animesphere",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Site de anime pe Cloudflare Pages + D1 + Durable Objects, buget zero",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "./dev.sh",
    "migrate:local": "wrangler d1 migrations apply DB --local",
    "migrate:remote": "wrangler d1 migrations apply DB --remote",
    "seed": "node tests/seed.mjs",
    "test": "node tests/e2e.mjs",
    "deploy": "./deploy.sh",
    "deploy:do": "cd worker-do && npx wrangler deploy",
    "dev:pages": "npx wrangler pages dev --port=8788"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "^29.1.1",
    "purgecss": "^8.0.0",
    "wrangler": "^4.84.1",
    "ws": "^8.21.3"
  }
}
