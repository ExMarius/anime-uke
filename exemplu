						$('#comment-box-success').html('<div class="row no-side-margin comment-text"><div class="col-12 no-side-padding">Comentariu postat.</div</div>');
					} else if (result.response.quality === 1) {
						$('#comment-box-success').html('<div class="row no-side-margin comment-text"><div class="col-12 no-side-padding">Comentariu trimis spre moderare. Probabil va apărea după ce e aprobat.</div</div>');
