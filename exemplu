        <script>
            //adaugă episod la vizionate
            var triggerWatchedStarted = false;
            var seconds = 0;
            function triggerWatchedCounter() {
                if (triggerWatchedStarted) {
                    return;
                }
                triggerWatchedStarted = true;
                var maxTime = 576;

                var checkWatch = setInterval(function() {
                    if (seconds === maxTime) {
                        setWatchedEpisode(0);
                        clearInterval(checkWatch);
                    }
                    seconds++;
                }, 1000);
            }

            function setWatchedEpisode(isManual) {
            var data_json = {};
            data_json.watchedSeriesId = 440;
            data_json.watchedLink = "one-piece";
            data_json.watchedNumber = "1";
            data_json.watchedSeriesName = "One Piece";
            data_json.manual = isManual;

        $.ajax({
        type: 'post',
        url: '/nexus/ep_seen/watched_episode',
        data: data_json,
                success: function(result) {
            var result = JSON.parse(result);
            $('#watched-container').removeClass('hide');
            if (result.message === 'success') {
                $('#watched-container').html('<div class="btn btn-success"><span class="fa fa-check-square"></span> Episod vizionat!</div>');
                // Episodul tocmai s-a marcat, deci conditia de comentare e indeplinita.
                // Descoperim caseta pe loc, altfel omul ar sta pe pagina, ar vedea ca s-a
                // marcat, si tot n-ar putea comenta pana la un refresh.
                $('#comment-locked-notice').remove();
                $('#comment-compose').removeClass('d-none');
                $('#comment-box-heading').removeClass('d-none');
                if (result.response.updatedMissions > 0) {
                    $('#watched-container').html('<a class="btn btn-success" href="/nexus/bingo" target="_blank"><span class="fa fa-check-square"></span> Episod vizionat! Misiuni actualizate: ' + result.response.updatedMissions + '</a>');
                }
            } else if (result.message === 'error' && result.response === 'duplicate') {
                $('#watched-container').html('<div class="btn btn-warning"><span class="fa fa-check-square"></span> Episod deja vizionat!</div>');
            } else if (result.message === 'error' && result.response === 'tooSoon') {
                $('#watched-container').html('<div class="btn btn-danger"><span class="fa fa-times-circle"></span> Ai vizionat deja un episod de curând!</div>');
            }
        }
            });
}


            $(window).scroll(function() {
                triggerWatchedCounter();
            });

            $('#watched-episode').on('click', function() {
                var r = confirm("Sigur vrei să adaugi episodul manual? Nu vei primi puncte și nu vei îndeplini misiuni.");
                if (r !== true) {
                    return;
                }
                setWatchedEpisode(1);
            });

            // Tooltip pe insigna "Vizionat anterior". Nu exista init global de tooltipuri
            // pe site, deci il pornim aici; Popper e incarcat in partials/top.php.
            // tabindex pe element + declansare pe focus ca sa mearga si la tap pe mobil,
            // unde hover nu exista. Dispare oricum cand containerul e inlocuit de
            // setWatchedEpisode() cu insigna verde plina.
            //
            // Clickul lasa elementul focusat, iar focusul tine tooltipul deschis si dupa
            // ce pleaca mouse-ul - ramanea agatat pe ecran. De aceea il deblocam explicit
            // cand mouse-ul iese si la scroll: pe mobil focusul ramane singurul declansator,
            // iar pe desktop hover-ul decide, ca peste tot.
            $('#watched-before-badge')
                .tooltip({trigger: 'hover focus'})
                .on('mouseleave', function() { $(this).blur(); });
            $(window).on('scroll', function() { $('#watched-before-badge').blur(); });

