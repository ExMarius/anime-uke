	function loadComments(commentsType, pageId, orderBy, limit, dontShowCommentsAlways = false) {
    var data_comments = {
        pageId: pageId,
        commentsType: commentsType,
        orderBy: orderBy,
        limit: limit,
    };
    $.ajax({
        type: 'post',
        url: '/nexus/comment/list',
        data: data_comments,
        beforeSend: function() {
            $('#loading').removeClass('d-none');
        },
        complete: function() {
            $('#loading').addClass('d-none');
        },
        success: function(result) {
            var result = JSON.parse(result);
            if (result.message !== 'success') {
                noComments();
                return;
            }

            // dontShowCommentAlways e deja folosit la thanks
            if (result.response.commentsCount > 10 && dontShowCommentsAlways) {
                return;
            }

            var allComments = result.response.commentsData || {};
            var pinnedComments = {};
            var normalComments = {};

            // 🔹 împărțim comentariile în pinned / normale
            for (var k in allComments) {
                if (!allComments.hasOwnProperty(k)) continue;
                if (allComments[k].isPinned) {
                    pinnedComments[k] = allComments[k];
                } else {
                    normalComments[k] = allComments[k];
                }
            }

            displayCommentsData(result.response, pinnedComments);
            displayPinnedComments(pinnedComments);
            displayComments(normalComments);

            // go to comment if highlighted
            if ($.isNumeric(hashId)) {
                if ($('#com-' + hashId).length > 0) {
                    $('html,body')
                        .animate({scrollTop: $('#com-' + hashId).offset().top-100});
                    $('#com-' + hashId)
                        .children('.comment-text-container').find('.comment-text').addClass('highlight-frame');
                } else {
                    // not found
                }
            }

            if (limit === commentsLimit && limit < result.response.commentsCount && limit !== 0) {
                $('.load-all-comments').removeClass('d-none');
                commentsLimit = 0;
            } else {
                $('.load-all-comments').addClass('d-none');
            }
        }
    });
}


