		comment = comment.split('<span class="spoiler_tag">').join('[spoiler]');
		comment = comment.split('<span class="bold">').join('[bold]');
		comment = comment.split('<span class="italic">').join('[italic]');
		comment = comment.split('</span>').join('[/tag]');
		return comment;
	}


