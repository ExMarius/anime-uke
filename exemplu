			data: data_json,
			success: function(result) {
				// raspuns non-JSON (ex. redirect la login pe sesiune expirata): daca
				// parse-ul arunca, jQuery sare peste complete si butonul ramane blocat
				try {
					var result = JSON.parse(result);
				} catch (e) {
