<script>
$(document).ready(function() {
    var $desc = $('#profile-description');
    var $toolbar = $('#pf-editor-toolbar');
    var isEditing = false;
    var savedRange = null;
    var editingAnchor = null;

    // ─── Save / restore cursor position (modal steals focus) ───
    function saveSelection() {
        var sel = window.getSelection();
        if (sel.rangeCount > 0) savedRange = sel.getRangeAt(0).cloneRange();
    }
    function restoreSelection() {
        if (!savedRange) return;
        var sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(savedRange);
    }

    // ─── Enter edit mode ───
    function startEditing() {
        if (isEditing) return;
        isEditing = true;
        $desc.attr('contenteditable', 'true');
        $toolbar.css('display', 'flex');
        $('#save-profile-changes').removeClass('hide');
        $desc.focus();
    }

    // ─── Toolbar: simple execCommand buttons ───
    $toolbar.on('click', '.pf-tb-btn[data-cmd]', function(e) {
        e.preventDefault();
        $desc.focus();
        document.execCommand($(this).data('cmd'), false, null);
    });

    // ─── Toolbar: color ───
    $('#pf-tb-color').on('change', function() {
        var v = $(this).val();
        if (v) { $desc.focus(); document.execCommand('foreColor', false, v); }
        $(this).val('');
    });

    // ─── Toolbar: font size ───
    $('#pf-tb-size').on('change', function() {
        var v = $(this).val();
        if (v) { $desc.focus(); document.execCommand('fontSize', false, v); }
        $(this).val('');
    });

    // ─── Toolbar: Unlink ───
    $('#pf-tb-unlink').on('click', function(e) {
        e.preventDefault();
        $desc.focus();
        document.execCommand('unlink', false, null);
    });

    // ─── Toolbar: Link button → open modal ───
    $('#pf-tb-link').on('click', function(e) {
        e.preventDefault();
        saveSelection();
        editingAnchor = null;

        var selectedText = '';
        var selectedHref = '';
        var sel = window.getSelection();
        if (sel.rangeCount > 0) {
            selectedText = sel.toString();
            var node = sel.focusNode;
            var anchor = node ? (node.nodeType === 1 ? node.closest('a') : (node.parentElement ? node.parentElement.closest('a') : null)) : null;
            if (anchor && $desc[0].contains(anchor)) {
                editingAnchor = anchor;
                selectedText = anchor.textContent;
                selectedHref = anchor.getAttribute('href') || '';
            }
        }

        $('#profileLinkText').val(selectedText);
        $('#profileLinkUrl').val(selectedHref);
        $('#profileLinkModalTitle').text(editingAnchor ? 'Editează link' : 'Inserează link');
        $('#profileLinkRemoveWrap').toggle(!!editingAnchor);
        $('#profileLinkModal').modal('show');
        setTimeout(function() {
            selectedHref ? $('#profileLinkUrl').focus().select() : (selectedText ? $('#profileLinkUrl').focus() : $('#profileLinkText').focus());
        }, 400);
    });

    // ─── Click on existing link → open edit modal ───
    $desc.on('click', 'a', function(e) {
        if (!isEditing) return;
        e.preventDefault();
        e.stopPropagation();
        editingAnchor = this;

        // Select the anchor contents so we have a range to restore
        var range = document.createRange();
        range.selectNodeContents(this);
        var sel = window.getSelection();
        sel.removeAllRanges();
        sel.addRange(range);
        saveSelection();

        $('#profileLinkText').val(this.textContent || '');
        $('#profileLinkUrl').val(this.getAttribute('href') || '');
        $('#profileLinkModalTitle').text('Editează link');
        $('#profileLinkRemoveWrap').show();
        $('#profileLinkModal').modal('show');
        setTimeout(function() { $('#profileLinkUrl').focus().select(); }, 400);
    });

    // ─── Toolbar: Insert image/GIF ───
    $('#pf-tb-img').on('click', function(e) {
        e.preventDefault();
        saveSelection();
        var imgUrl = prompt('Introdu URL-ul imaginii sau GIF-ului:');
        if (!imgUrl || !imgUrl.trim()) return;
        imgUrl = imgUrl.trim();
        if (!/^https?:\/\//i.test(imgUrl)) imgUrl = 'https://' + imgUrl;
        $desc.focus();
        restoreSelection();
        document.execCommand('insertHTML', false, '<img src="' + imgUrl.replace(/&/g,'&amp;').replace(/"/g,'&quot;') + '" alt="image">');
    });

    // ─── Ctrl+K shortcut ───
    $desc.on('keydown', function(e) {
        if (e.ctrlKey && (e.key === 'k' || e.key === 'K')) {
            e.preventDefault();
            $('#pf-tb-link').click();
        }
    });

    // ─── Modal: Insert or Update link ───
    $('#profileLinkInsert').on('click', function() {
        var linkText = $('#profileLinkText').val().trim();
        var linkUrl  = $('#profileLinkUrl').val().trim();

        if (!linkUrl) { alert('Te rog introdu o adresă URL.'); $('#profileLinkUrl').focus(); return; }
        if (!/^https?:\/\//i.test(linkUrl)) linkUrl = 'https://' + linkUrl;
        if (!linkText) linkText = linkUrl;

        $('#profileLinkModal').modal('hide');

        setTimeout(function() {
            $desc.focus();

            if (editingAnchor && $desc[0].contains(editingAnchor)) {
                // ── Update existing <a> ──
                editingAnchor.href = linkUrl;
                editingAnchor.target = '_blank';
                editingAnchor.rel = 'noopener noreferrer';
                editingAnchor.textContent = linkText;
            } else {
                // ── Insert new <a> at cursor ──
                restoreSelection();
                var sel = window.getSelection();
                if (sel.rangeCount > 0 && !sel.isCollapsed) {
                    document.execCommand('delete', false, null);
                }
                var safeUrl  = linkUrl.replace(/&/g,'&amp;').replace(/"/g,'&quot;');
                var safeText = linkText.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
                document.execCommand('insertHTML', false,
                    '<a href="' + safeUrl + '" target="_blank" rel="noopener noreferrer">' + safeText + '</a>'
                );
            }
            editingAnchor = null;
        }, 300);
    });

    // ─── Modal: Remove link ───
    $('#profileLinkRemove').on('click', function() {
        $('#profileLinkModal').modal('hide');
        setTimeout(function() {
            if (editingAnchor && $desc[0].contains(editingAnchor)) {
                var txt = document.createTextNode(editingAnchor.textContent);
                editingAnchor.parentNode.replaceChild(txt, editingAnchor);
            }
            editingAnchor = null;
            $desc.focus();
        }, 300);
    });

    // ─── Modal: Enter = submit ───
    $('#profileLinkModal').on('keydown', 'input', function(e) {
        if (e.key === 'Enter') { e.preventDefault(); $('#profileLinkInsert').click(); }
    });

    // ─── Open edit from profile button ───
    $('body').on('click', '#editProfileButton', function() {
        $('#userProfile').modal('show');
        startEditing();
    });

    // ─── Start editing on focus ───
    $desc.on('focus', function() { startEditing(); });

    // ─── Cancel ───
    $('body').on('click', '#editProfileDialogue1', function() { location.reload(); });

    // ─── Save ───
    $('body').on('click', '#editProfileDialogue2', function() {
        var html = $desc.html();
        if (html.length > 10000) { alert('Descrierea e prea lungă!'); return; }

        $.ajax({
            type: 'post',
            url: '/nexus/user/edit_profile_text',
            data: { profileId: $('#profile-id').val(), profileText: html },
            success: function(result) {
                var r = JSON.parse(result);
                if (r.message === 'success') { location.reload(); } else { alert('Eroare.'); }
            }
        });
    });
});
</script>

