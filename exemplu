	function noComments() {
        $('#comments-data-container')
            .removeClass('d-none')
            .find('.no-comments').removeClass('d-none');
        $('.load-comments').addClass('d-none');
    }

	function displayCommentsData(data, pinnedComments) {
    var container = $('#comments-data-container');

    if (data.commentsType === 'ep') {
        container.find('#comments-thanks-container').removeClass('d-none');
        container.find('#display-time').text(data.thanksData.displayTime);
        container.find('#total-thanks').text(data.thanksData.totalThanks);
        container.find('#users-thanks').html(data.thanksData.usersThanks);
        if (data.thanksData.totalThanksAccount > 30) {
            container.find('#users-thanks').append(' <span class="comment-thanks-ellipsis font-weight-bold">[...]</span> <div class="show-more-thanks font-weight-bold pointer text-center mt-2 w-100">...arată mai multe</div>');
        }
        if (data.thanksData.totalThanksAnonymous > 0) {
            container.find('.anonymous-thanks').removeClass('d-none');
            container.find('#total-thanks-anonymous').text(data.thanksData.totalThanksAnonymous);
        }
    }

    if (Object.keys(data.commentsData).length > 0) {
        container.find('.comments-data').removeClass('d-none');
        container.find('#comments-total-count').text(data.commentsCount);
    } else {
        noComments();
    }

    var hasPinned = pinnedComments && Object.keys(pinnedComments).length > 0;
    if (hasPinned) {
        container.find('.pinned-comments').removeClass('d-none');
    } else {
        container.find('.pinned-comments').addClass('d-none');
    }

    container.removeClass('d-none');
    $('.load-comments').addClass('d-none');
}


    $('body').on('click', '.show-more-thanks', function(event) {
        $(event.currentTarget).addClass('d-none');
        $('.comment-thanks-ellipsis').addClass('d-none');
        $('.thanks-user').removeClass('d-none');
    });

    $('body').on('click', '.load-all-comments', function(event) {
        $(event.currentTarget).addClass('d-none');
        loadComments(commentsType, pageId, 'newest')
    });

    function sortComments(type) {
        var $wrapper = $('#comments-container');
        var $target = '.comment-container:not(".child-comment")';
        if (type === 'oldest') {
            $wrapper.find($target).sort(function(a, b) {
                return +a.dataset.id - +b.dataset.id;
            }).appendTo($wrapper);
        }
        if (type === 'newest') {
            $wrapper.find($target).sort(function(a, b) {
                return +b.dataset.id - +a.dataset.id;
            }).appendTo($wrapper);
        }
        if (type === 'votes') {
            $wrapper.find($target).sort(function(a, b) {
                return +b.dataset.votes - +a.dataset.votes;
            }).appendTo($wrapper);
        }
