            var result = JSON.parse(result);
            if (result.message == 'success') {
                alert('Comentariu ales!');
            } else if (result.message == 'duplicate') {
                alert('Deja ai ales un comentariu azi!');
            } else {
                alert('Eroare.');
            }
            $(this).removeClass('red');
            $(this).addClass('grey'); // Schimbă butonul în gri după selectare
        }
    });
});


