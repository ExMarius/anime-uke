            <script>
      $(function(){
          var $g = $('.pf-badge-grid');
          if(!$g.length) return;

          function buildBadgeShelves() {
              $g.find('.pf-badge-shelf,.pf-badge-shelf-flat').remove();
              var items = $g.children('.pf-badge-item').toArray();
              if(!items.length) return;

              var rows = [], cur = [], lastT = null;
              items.forEach(function(el){
                  var t = el.getBoundingClientRect().top;
                  if(lastT !== null && Math.abs(t - lastT) > 5){
                      rows.push(cur);
                      cur = [];
                  }
                  cur.push(el);
                  lastT = t;
              });
              if(cur.length) rows.push(cur);

              var gr = $g[0].getBoundingClientRect();
              rows.forEach(function(r){
                  var imageRects = r.map(function(el){
                      var img = el.querySelector('img');
                      return img ? img.getBoundingClientRect() : el.getBoundingClientRect();
                  });
                  var rowLeft = Math.min.apply(null, imageRects.map(function(rect){ return rect.left - gr.left; })) + 2;
                  var rowRight = Math.max.apply(null, imageRects.map(function(rect){ return rect.right - gr.left; })) - 2;
                  var bot = Math.max.apply(null, imageRects.map(function(rect){ return rect.bottom; })) - gr.top;
                  var shelfW = Math.max(52, rowRight - rowLeft);
                  var $shelf = $('<div class="pf-badge-shelf"></div>').css({
                      top: (bot - 15) + 'px',
                      left: rowLeft + 'px',
                      width: shelfW + 'px'
                  });
                  $g.append($shelf);
                  var rendered = $shelf[0].getBoundingClientRect();
                  $g.append(
                      $('<div class="pf-badge-shelf-flat"></div>').css({
                          top: (bot + 7) + 'px',
                          left: rendered.left - gr.left + 'px',
                          width: Math.max(50, rendered.width - 2) + 'px'
                      })
                  );
              });
          }

          buildBadgeShelves();
          $(window).on('resize', function() {
              window.requestAnimationFrame(buildBadgeShelves);
          });
      });
      </script>
      
