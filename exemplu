	//vote comment
	$('body').on('click', '.comment-vote', function() {
		// dublu-click = doua POST-uri identice simultane -> deadlock in MySQL pe voturi
		if ($(this).hasClass('vote-pending')) {
			return;
		}
		$(this).addClass('vote-pending');
		var data_json = {};
