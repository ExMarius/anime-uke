<script>
$(document).ready(function() {
    var ITEMS_PER_PAGE = 60;

    // Initialize each series-paged-modal
    $('.series-paged-modal').each(function() {
        var $modal = $(this);
        var $allItems = $modal.find('.series-modal-item');
        var $search = $modal.find('.series-modal-search');
        var $listArea = $modal.find('.series-modal-list-area');
        var $pager = $modal.find('.series-modal-pager');
        var $noResults = $modal.find('.series-modal-no-results');
        var currentPage = 1;
        var filteredItems = $allItems.toArray();

        function renderPage() {
            $allItems.removeClass('series-modal-visible');
            var total = filteredItems.length;
            var totalPages = Math.max(1, Math.ceil(total / ITEMS_PER_PAGE));
            if (currentPage > totalPages) currentPage = totalPages;
            var start = (currentPage - 1) * ITEMS_PER_PAGE;
            var end = Math.min(start + ITEMS_PER_PAGE, total);

            for (var i = start; i < end; i++) {
                $(filteredItems[i]).addClass('series-modal-visible');
            }

            if (total === 0) {
                $noResults.show();
                $pager.hide();
            } else {
                $noResults.hide();
                $pager.show();
                buildPager(totalPages, total);
            }
        }

        function buildPager(totalPages, totalItems) {
            $pager.empty();

            // Prev button
            $pager.append(
                $('<a class="sp-btn' + (currentPage === 1 ? ' sp-disabled' : '') + '" href="javascript:void(0)">').html('&laquo;').attr('data-page', currentPage - 1)
            );

            // Page numbers with ellipsis
            var pages = getPageNumbers(currentPage, totalPages);
            for (var i = 0; i < pages.length; i++) {
                if (pages[i] === '...') {
                    $pager.append('<span class="sp-ellipsis">…</span>');
                } else {
                    var cls = 'sp-btn' + (pages[i] === currentPage ? ' sp-active' : '');
                    $pager.append(
                        $('<a class="' + cls + '" href="javascript:void(0)">').text(pages[i]).attr('data-page', pages[i])
                    );
                }
            }

            // Next button
            $pager.append(
                $('<a class="sp-btn' + (currentPage === totalPages ? ' sp-disabled' : '') + '" href="javascript:void(0)">').html('&raquo;').attr('data-page', currentPage + 1)
            );

            // Info
            var startItem = (currentPage - 1) * ITEMS_PER_PAGE + 1;
            var endItem = Math.min(currentPage * ITEMS_PER_PAGE, totalItems);
            $pager.append('<span class="sp-info">' + startItem + '–' + endItem + ' din ' + totalItems + '</span>');
        }

        function getPageNumbers(current, total) {
            if (total <= 7) {
                var arr = [];
                for (var i = 1; i <= total; i++) arr.push(i);
                return arr;
            }
            var pages = [];
            pages.push(1);
            if (current > 3) pages.push('...');
            var rangeStart = Math.max(2, current - 1);
            var rangeEnd = Math.min(total - 1, current + 1);
            for (var i = rangeStart; i <= rangeEnd; i++) pages.push(i);
            if (current < total - 2) pages.push('...');
            pages.push(total);
            return pages;
        }

        // Pager click
        $pager.on('click', '.sp-btn:not(.sp-disabled):not(.sp-active)', function(e) {
            e.preventDefault();
            currentPage = parseInt($(this).attr('data-page'));
            renderPage();
            $modal.find('.series-modal-list-area').animate({ scrollTop: 0 }, 150);
        });

        // Search
        $search.on('input', function() {
            var query = $(this).val().toLowerCase().trim();
            if (query === '') {
                filteredItems = $allItems.toArray();
            } else {
                filteredItems = $allItems.filter(function() {
                    return $(this).text().toLowerCase().indexOf(query) !== -1;
                }).toArray();
            }
            currentPage = 1;
            renderPage();
        });

        // Reset on modal close
        $modal.on('hidden.bs.modal', function() {
            $search.val('');
            filteredItems = $allItems.toArray();
            currentPage = 1;
            renderPage();
        });

        // Auto-focus search on modal open
        $modal.on('shown.bs.modal', function() {
            $search.focus();
            renderPage();
        });

        // Initial render (hidden items)
        renderPage();

        // Add title tooltip on links for ellipsis names
        $allItems.find('a').each(function() {
            $(this).attr('title', $(this).text().trim());
        });
    });
});
</script>
