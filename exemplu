<script>

var isStaff = false;

function countWords(text) {
    // Cand comentariile sunt inchise caseta nu se randeaza, iar `.val()` da `undefined`.
    // Fara garda asta, cine a comentat inainte de blocare si apasa "editeaza" pe propriul
    // comentariu primea `undefined.match is not a function` si clickul murea in tacere.
    if (!text) {
        return 0;
    }
    const wordRegex = /[\p{L}0-9]{2,}/gu;
    const words = text.match(wordRegex);
    return words ? words.length : 0;
}

function toggleCommentButton() {
    const text = $('#comment-box-text').val();
    const wordCount = countWords(text);
    const minWords = 20;
    const editingReply = $('#comment-box-id').val() !== "" && $('#comment-box-id').data('isReply') === true;
    const isReply = $('#comment-box-reply-id').val() !== "" || editingReply;

    if (isStaff || isReply || commentsType == 'user') {
        $('#comment-box-submit').prop('disabled', false);
        $('#comment-box-charcount').text('');
        $('#comment-box-text').removeClass('error-border');
    } else {
        if (wordCount >= minWords) {
            $('#comment-box-submit').prop('disabled', false);
            $('#comment-box-charcount').text(`Comentariul este valid: ${wordCount} cuvinte.`);
            $('#comment-box-text').removeClass('error-border');
        } else {
            $('#comment-box-submit').prop('disabled', true);
            $('#comment-box-charcount').text(`Ai scris ${wordCount} din ${minWords} cuvinte necesare.`);
            $('#comment-box-text').addClass('error-border');
        }
    }
}


$('#comment-box-text').on('input', function () {
    toggleCommentButton();
	talkToUserComment();
});

	//warn before leaving
	window.addEventListener("beforeunload", function (e) {
		// Test de adevar, nu `!= ''`. Cand comentariile sunt inchise (episod nevizionat,
		// anunt cu comentarii oprite) caseta nu se randeaza deloc, iar `.val()` intoarce
		// `undefined` - si `undefined != ''` e TRUE in JS, deci avertismentul sarea la
		// orice navigare, fara ca omul sa fi scris ceva.
		if ($('#comment-box-text').val()) {
			var confirmationMessage = 'Nu vrei să trimiţi comentariul înainte să pleci?';
			(e || window.event).returnValue = confirmationMessage; //Gecko + IE
			return confirmationMessage; //Gecko + Webkit, Safari, Chrome etc.
		}
	});

    var commentsLimit = 10; //10 comments loaded at first

    var hash = location.hash.substr(1);
    var hashId;
    if (hash.startsWith('com')) {
        commentsLimit = 0;
        hashId = hash.substring(hash.indexOf('-') + 1);
    }

    //go to comment if highlighted
   	if($.isNumeric(hashId)) {
   		$('html,body').animate({scrollTop: $('.comments-container').offset().top-100});
   		window.addEventListener("load", function() {
   			$('#show-comments').trigger('click');
   		});
   	}

	//report comment
	$('body').on('click', '.comment-report-submit', function() {
		var data_json = {};
		data_json.commentReportId = $(this).closest('.comment-container').attr('data-id');
		data_json.commentReportDate = $(this).closest('.comment-container').attr('data-date');
		data_json.commentReportText = $(this).siblings('.comment-report-text').val();
		data_json.commentReportPageId = '';

		$.ajax({
			type: 'post',
			url: '/nexus/comment/report',
			context: this,
			data: data_json,
			success: function(result) {
				var result = JSON.parse(result);
				if (result.message == 'success') {
					//alert('Comentariu raportat!');
					$(this).closest('.comment-container').addClass('hide');
					$(this).closest('.modal').modal("toggle");
				} else {
					alert('Completează motivul!');
				}
			}
		});
	});

	//moderate comment - approve (data-q="0")
	$('body').on('click', '.comment-moderate', function() {
		var data_json = {};
		data_json.action = $(this).attr('data-q');
		data_json.id = $(this).closest('.comment-container').attr('data-id');
		data_json.date = $(this).closest('.comment-container').attr('data-date');
		data_json.account = $(this).closest('.comment-container').attr('data-account');
		data_json.username = $(this).closest('.comment-container').attr('data-username');
		data_json.userId = $(this).closest('.comment-container').attr('data-userId');
		data_json.pageId = '';

		$.ajax({
			type: 'post',
			url: '/nexus/comment/moderate',
			context: this,
			data: data_json,
			success: function(result) {
				var result = JSON.parse(result);
				if (result.message == 'success') {
					if (result.response.quality == 0) {
						$(this).closest('.comment-container').find('.reported-comment').removeClass('reported-comment');
						$(this).closest('.comment-container').find('.comment-moderate').addClass('hide');
						$(this).closest('.comment-container').find('.comment-delete-btn').addClass('d-none');
						$(this).closest('.comment-container').find('.reported-text').addClass('hide');
