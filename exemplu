/* scantei care urca si se sting - transform + opacity (GPU, fara lag) */
.main-body::before,
.main-body::after {
	content: "";
	position: fixed;
	left: 0;
	bottom: 0;
	width: 7px;
	height: 7px;
	border-radius: 50%;
	background: transparent;
	pointer-events: none;
	z-index: 9999;
	will-change: transform, opacity;
}
.main-body::before {
	box-shadow:
		6vw -4vh 7px 3px rgba(255,150,60,.9),
		18vw -20vh 8px 3px rgba(255,120,40,.85),
		31vw -8vh 6px 2px rgba(255,170,80,.8),
		44vw -28vh 8px 3px rgba(255,130,50,.9),
		58vw -12vh 6px 2px rgba(255,160,70,.85),
		72vw -32vh 8px 3px rgba(255,120,40,.9),
		85vw -16vh 6px 2px rgba(255,180,90,.8),
		95vw -2vh 7px 3px rgba(255,140,55,.85);
	animation: nx-ember 8s linear infinite;
}
.main-body::after {
	box-shadow:
		11vw -10vh 6px 2px rgba(255,170,80,.8),
		26vw -30vh 8px 3px rgba(255,120,40,.9),
		39vw -18vh 6px 2px rgba(255,150,60,.85),
		52vw -4vh 8px 3px rgba(255,130,50,.9),
		66vw -24vh 6px 2px rgba(255,180,90,.8),
		79vw -36vh 8px 3px rgba(255,120,40,.9),
		90vw -8vh 6px 2px rgba(255,160,70,.85),
		3vw -26vh 8px 3px rgba(255,140,55,.9);
	animation: nx-ember 6s linear infinite;
	animation-delay: -3s;
}
@keyframes nx-ember {
	0%   { transform: translateY(0); opacity: 0; }
	10%  { opacity: 1; }
	85%  { opacity: 1; }
	100% { transform: translateY(-110vh); opacity: 0; }
}
