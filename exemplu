<script>
document.addEventListener("keydown", (e) => {
  const key = (e.key || "").toLowerCase();
  const code = (e.code || "").toLowerCase();

  const blocked = [
    {ctrl:true, shift:false, alt:false, meta:false, key:"u"},
    {ctrl:true, shift:false, alt:false, meta:false, key:"s"},

    {ctrl:true, shift:true,  alt:false, meta:false, key:"i"},
    {ctrl:true, shift:true,  alt:false, meta:false, key:"j"},
    {ctrl:true, shift:true,  alt:false, meta:false, key:"c"},
    {ctrl:true, shift:true,  alt:false, meta:false, key:"m"},
    {ctrl:false,shift:false, alt:false, meta:false, key:"f12"},

    {ctrl:false,shift:false, alt:true,  meta:true,  key:"i"},
    {ctrl:false,shift:false, alt:true,  meta:true,  key:"j"},
    {ctrl:false,shift:true,  alt:false, meta:true,  key:"c"},
  ];

  for (const combo of blocked) {
    const okMods =
      e.ctrlKey === combo.ctrl &&
      e.shiftKey === combo.shift &&
      e.altKey === combo.alt &&
      e.metaKey === combo.meta;

    const okKey =
      key === combo.key ||
      code === combo.key; 

    const isF12 = (combo.key === "f12") && (code === "f12" || key === "f12");

    if (okMods && (okKey || isF12)) {
      e.preventDefault();
      e.stopPropagation();
      e.stopImmediatePropagation();
      window.location.href = "/";
      return;
    }
  }
}, true);

