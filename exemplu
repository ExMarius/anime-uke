$(document).ready(function() {
    function filterTeamList() {
        var searchTerm = $('#memberSearch').val().toLowerCase(); 
        var selectedRole = $('#roleFilter').val(); 
        var visibleCount = 0; 

        $('#noResults').addClass('d-none');
        $('.member-item').each(function() {
            var memberName = $(this).data('name');
            var memberRole = $(this).data('role');
            var matchesSearch = memberName.indexOf(searchTerm) > -1;
            var matchesRole = selectedRole === "" || memberRole === selectedRole;

            if (matchesSearch && matchesRole) {
                $(this).removeClass('d-none'); 
                visibleCount++;
            } else {
                $(this).addClass('d-none'); 
            }
        });

        $('.category-row').each(function() {
            var visibleMembersInThisCategory = $(this).find('.member-item:not(.d-none)').length;
            if (visibleMembersInThisCategory === 0) {
                $(this).addClass('d-none');
            } else {
                $(this).removeClass('d-none');
            }
        });

        if (visibleCount === 0) {
            $('#noResults').removeClass('d-none');
        }
    }

    $(document).on('keyup', '#memberSearch', function() {
        filterTeamList();
    });

    $(document).on('change', '#roleFilter', function() {
        filterTeamList();
    });
});
	</script>

