				} else {
					alert('Eroare.');
				}
			}
		});
	});

	//moderate comment - delete via modal
	var deleteCommentContainer = null;
	$('body').on('click', '.comment-delete-btn', function() {
		deleteCommentContainer = $(this).closest('.comment-container');
		$('#comment-delete-reason').val('');
	});

	$('#comment-delete-confirm').on('click', function() {
		if (!deleteCommentContainer) return;
		var container = deleteCommentContainer;
		var data_json = {};
		data_json.action = 2;
		data_json.id = container.attr('data-id');
		data_json.date = container.attr('data-date');
		data_json.account = container.attr('data-account');
		data_json.username = container.attr('data-username');
		data_json.userId = container.attr('data-userId');
		data_json.pageId = '';

		var reason = $('#comment-delete-reason').val();
		if (reason && reason.trim() !== "") {
			data_json.reason = reason.trim();
		}

		$.ajax({
			type: 'post',
			url: '/nexus/comment/moderate',
			data: data_json,
			success: function(result) {
				var result = JSON.parse(result);
				if (result.message == 'success') {
					container.addClass('hide');
					$('#comment-delete-modal').modal('hide');
				} else {
					alert('Eroare.');
				}
			}
		});
	});

	//vote comment
	$('body').on('click', '.comment-vote', function() {
		// dublu-click = doua POST-uri identice simultane -> deadlock in MySQL pe voturi
		if ($(this).hasClass('vote-pending')) {
			return;
		}
		$(this).addClass('vote-pending');
		var data_json = {};
		data_json.commentVoteId = $(this).closest('.comment-container').attr('data-id');
		data_json.commentVoteUsername = $(this).closest('.comment-container').attr('data-username');
		data_json.commentVotedUserId = $(this).closest('.comment-container').attr('data-userId');
		data_json.commentVoteAccount = $(this).closest('.comment-container').attr('data-account');
		data_json.commentVotePageType = 'user';
		data_json.commentVotePageId = '';
		//if on episode page and it is watched
		if (typeof watchedScore != 'undefined' && watchedScore >= 1 && watchedScore <= 2) {
			data_json.commentVoteWatchedScore = watchedScore;
		} else {
			data_json.commentVoteWatchedScore = 1;
		}

		$.ajax({
			type: 'post',
			url: '/nexus/comment/vote',
			context: this,
			data: data_json,
			success: function(result) {
				// raspuns non-JSON (ex. redirect la login pe sesiune expirata): daca
				// parse-ul arunca, jQuery sare peste complete si butonul ramane blocat
				try {
					var result = JSON.parse(result);
				} catch (e) {
					return;
				}
				if (result.message == 'success') {
					//alert('Comentariu votat!');
					var votes = parseInt($(this).siblings().children('.votes-amount').text());
					$(this).siblings().children('.votes-amount').text(votes+1);
				} else if (result.message == 'duplicate') {
					//alert('Ai votat deja!');
				}
				$(this).removeClass('green');
				$(this).addClass('grey');
			},
			complete: function() {
				$(this).removeClass('vote-pending');
			}
		});
	});

	//actual comment
	$('body').on('click', '#comment-box-submit', function() {
		$('#comment-box-submit').addClass('hide');
		$(this).parent().siblings().each(function() {
			$(this).removeClass('error-border');
		});
		var data_json = {};
		data_json.commentBoxId = $("#comment-box-id").val();
		data_json.commentBoxDate = $("#comment-box-date").val();
		data_json.commentBoxUsername = $("#comment-box-username").val();
		data_json.commentBoxText = $("#comment-box-text").val();
		data_json.commentBoxReplyId = $("#comment-box-reply-id").val();
		data_json.commentBoxReplyIdParent = $("#comment-box-reply-id-parent").val();
		data_json.commentBoxReplyTo = $("#comment-box-reply-to").val();
        data_json.commentBoxReplyToUserId = $("#comment-box-reply-to-userId").val();
		data_json.commentBoxReplyToAccount = $("#comment-box-reply-to-account").val();
		data_json.commentBoxPageType = "user";
		data_json.commentBoxPageUnique = "351644";
        data_json.commentBoxPageId = "";
				//if on episode page and it is watched
		if (typeof watchedScore != "undefined" && watchedScore >= 1 && watchedScore <= 2) {
			data_json.commentBoxWatchedScore = watchedScore;
		} else {
			data_json.commentBoxWatchedScore = 1;
		}

		$.ajax({
			type: 'post',
			url: '/nexus/comment',
			context: this,
			data: data_json,
			success: function(result) {
				var result = JSON.parse(result);
				if (result.message == 'success') {
					$('#comment-box-error').html('');
					resetEdit();
					resetReply();
					if (result.response.quality === 0) {
						$('#comment-box-success').html('<div class="row no-side-margin comment-text"><div class="col-12 no-side-padding">Comentariu postat.</div</div>');
					} else if (result.response.quality === 1) {
						$('#comment-box-success').html('<div class="row no-side-margin comment-text"><div class="col-12 no-side-padding">Comentariu trimis spre moderare. Probabil va apărea după ce e aprobat.</div</div>');
					}
					loadComments(commentsType, pageId, 'newest', commentsLimit);
				} else {
					$('#comment-box-success').html('');
					if (result.message == 'missing') {
						$('#comment-box-error').text('Completează ce e necesar!');
						$.each(result.response, function(key, value) {
							$('#'+value).addClass('error-border');
						});
					} else if (result.message == 'nocomment') {
                     $('#comment-box-error').text('Nu poți lăsa mai mult de un comentariu în decurs de o oră!');
                     }
					// Singurul caz in care afisam textul trimis de server: mesajul difera
					// intre episod si capitol, si n-are rost sa duplicam decizia aici.
					else if (result.message == 'notWatched') {
						$('#comment-box-error').text(result.response);
					}
					else if (result.message == 'lowActivity') {
						$('#comment-box-error').text('Ai prea puțină activitate pe site, nu poți posta comentarii la profil.');
					}
					else if (result.message == 'badName') {
						$('#comment-box-error').text('Doar litere și cifre în nume!');
						$('#comment-box-username').addClass('error-border');
					} else {
						$('#comment-box-error').text('Eroare.');
					}
				}
				$('#comment-box-submit').removeClass('hide');
			}
		});
	});

	//click on reply
	$('body').on('click', '.comment-reply', function() {
        // dacă butonul e în interiorul unui pinned comment (sau sub el), nu permitem reply
    if ($(this).closest('.pinned-comment').length) {
        $('#comment-box-error').text('Nu poți răspunde la un comentariu fixat.');
