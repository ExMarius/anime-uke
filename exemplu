<script>
$(document).ready(function() {
    var $gand = $('#gand-description');
    var $gandToolbar = $('#gand-editor-toolbar');
    var isEditingGand = false;

    function startGandEditing() {
        if (isEditingGand) return;
        isEditingGand = true;
        $gand.attr('contenteditable', 'true');
        $gandToolbar.css('display', 'flex');
        $('#save-gand-changes').removeClass('hide');
        $gand.focus();
    }

    $('body').on('click', '#editGandButton', function() {
        $('#userGand').modal('show');
        setTimeout(function() {
            startGandEditing();
        }, 250);
    });

    $gand.on('focus', function() {
        startGandEditing();
    });

    $gandToolbar.on('click', '.pf-tb-btn[data-cmd]', function(e) {
        e.preventDefault();
        $gand.focus();
        document.execCommand($(this).data('cmd'), false, null);
    });

    $('body').on('click', '#editGandDialogue1', function() {
        location.reload();
    });

    $('body').on('click', '#editGandDialogue2', function() {
        var plainText = $gand.text().trim();
        var html = $gand.html().trim();

        if (plainText.length > 130) {
            alert('Cam prea multe gânduri îți trec prin cap!');
            return;
        }

        $.ajax({
            type: 'post',
            url: '/nexus/user/edit_motto',
            data: {
                profileId: $('#profile-id').val(),
                motto: html
            },
            success: function(result) {
                var r = JSON.parse(result);
                if (r.message === 'success') {
                    location.reload();
                } else {
                    alert('Eroare.');
                }
            }
        });
    });
});
</script>


