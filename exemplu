	//cancel reply
	$('body').on('click', '#comment-box-reply-remove', function() {
		resetReply();
	});

	//click on edit
	$('body').on('click', '.comment-edit', function() {
		resetReply();
		$('html,body').animate({scrollTop: $('.comments-container').offset().top-100});
		$('#comment-box-edit-remove').removeClass('hide');
		var $editedContainer = $(this).closest('.comment-container');
		var parentId = $editedContainer.attr('data-id-parent');
		var editingReply = $editedContainer.hasClass('child-comment') || (parentId !== undefined && parentId !== '' && parentId !== '0');
		$('#comment-box-id').data('isReply', editingReply);
		$('#comment-box-id').val($editedContainer.attr('data-id'));
		$('#comment-box-date').val($editedContainer.attr('data-date'));
		var text = resetTags($(this).closest('.comment-container').find('.comment-text').html()).replace(/<br\s*\/?>/mg,"");
		var text = $('<textarea />').html(text).text();
		$('#comment-box-text').val(text);
        toggleCommentButton();
          if (typeof talkToUserComment === 'function') {
        talkToUserComment();
    }
	});
	//cancel edit
	$('body').on('click', '#comment-box-edit-remove', function() {
		resetEdit();
	});

	//click on featured comment
	$('body').on('click', '.comment-feature', function(e) {
    var $commentContainer = $(e.currentTarget).closest('.comment-container');
    var commentText = $commentContainer.find('.comment-text').text();

    var wordCount = commentText.trim().split(/\s+/).length;

    if (wordCount < 20) {
