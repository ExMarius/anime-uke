        $('#comment-word-count')
        .removeClass('d-none')
        .text('Ai scris ' + currentWordCount + ' din 20 cuvinte necesare.');
        } else {
        $('#comment-word-count').addClass('d-none');
        }

		var isEditing = $('#comment-box-id').val() !== "";

		if (sameCharRegex.exec(text) !== null) {
			//repeating same shit
			$('#comment-box-success').text('');
			$('#comment-box-error').text('Heeeeei, repeți același caracter prea mult!');
		} else if (longWordRegex.exec(text) !== null) {
			//long word
			$('#comment-box-success').text('');
			$('#comment-box-error').text('Cuvântul acela pare foarte lung!');
		} else if (currentWordCount < 7 && (text.search(/mesc/i) > -1 || text.search(/ms/i) > -1 || text.search(/mersi/i) > -1 || text.search(/thx/i) > -1)) {
			//less than seven words, and only thanks? wtf?
			$('#comment-box-success').text('');
			$('#comment-box-error').text('Sper că nu are de gând doar să mulțumească pentru episod :(');
		} else if (isEditing) {
			// la edit nu afișăm flavor text
			$('#comment-box-success').text('');
			$('#comment-box-error').text('');
		} else if (currentWordCount < 7 && (text.search(/tare/i) > -1 || text.search(/super/i) > -1 || text.search(/interesant/i) > -1)) {
			//less than seven words, and only tare sau super? wtf?
			$('#comment-box-success').text('Super! Ce anume ți-a plăcut la episod? :)');
			$('#comment-box-error').text('');
		} else if (text.length < 30) {
			$('#comment-box-success').text('Uuu... comentariu nou.');
			$('#comment-box-error').text('');
		} else if (text.length < 80) {
			$('#comment-box-success').text('Îmi place cum scrii!');
			$('#comment-box-error').text('');
		} else if (text.length < 200) {
			$('#comment-box-success').text('Spui chestii interesante.');
			$('#comment-box-error').text('');
		} else if (text.length < 1000) {
			$('#comment-box-success').text('Wow, ce comentariu elaborat.');
			$('#comment-box-error').text('');
		} else if (text.length < 2000) {
			$('#comment-box-success').text('Creangă ar fi invidios');
			$('#comment-box-error').text('');
		} else if (text.length < 10000) {
			$('#comment-box-success').text('Ce comentariu lung. Ești de neoprit!');
			$('#comment-box-error').text('');
		} else if (text.length == 10000) {
			$('#comment-box-success').text('OMG A AJUNS LA LIMITĂ :O');
			$('#comment-box-error').text('');
		}

	}



