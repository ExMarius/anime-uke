		$('#comment-box-reply-id-parent').val($(this).closest('.comment-container').attr('data-id-parent'));
		$('#comment-box-reply-to').val($(this).closest('.comment-container').attr('data-username'));
		$('#comment-box-reply-to-userId').val($(this).closest('.comment-container').attr('data-userId'));
		$('#comment-box-reply-to-account').val($(this).closest('.comment-container').attr('data-account'));
