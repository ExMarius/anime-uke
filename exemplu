    $('body').on('click', '#report-submit', function() {

        // Verifică dacă a fost selectată cel puțin o sursă
    if ($('#report-source').val() === null || $('#report-source').val().length === 0) {
        $('#report-error').text('Selectează sursa/sursele care nu funcționează!');
        $('#report-source').addClass('error-border');
        return;
    } else {
        $('#report-source').removeClass('error-border');
        $('#report-error').text('');
    }

        $('#report-submit').addClass('hide');
        $('.loading').toggleClass('d-none');
        var imageAddr = "/media/logo/logo-nexus.webp" + "?n=" + Math.random();
        var startTime, endTime;
        var downloadSize = 270470;
        var download = new Image();
        download.onload = function () {
            endTime = (new Date()).getTime();
            showResults();
        };
        startTime = (new Date()).getTime();
        download.src = imageAddr;

        function showResults() {
            var duration = (endTime - startTime) / 1000; //Math.round()
            var bitsLoaded = downloadSize * 8;
            var speedBps = (bitsLoaded / duration).toFixed(2);
            var speedKbps = (speedBps / 1024).toFixed(0);

            var data_json = {};
            data_json.reportLink = "one-piece";
            data_json.reportNumber = "1";
            data_json.reportReason = $('#report-reason').val();
            data_json.reportSubscribeEmail = +$('#report-email').is(':checked');
            data_json.reportSubscribeNotification = +$('#report-notification').is(':checked');
            data_json.reportInfo = JSON.stringify(sourceInfo);
            data_json.reportSeconds = seconds;
            data_json.reportSpeed = speedKbps;
            data_json.reportSource = $('#report-source').val();

            $.ajax({
                type: 'post',
                url: '/nexus/ep/report_episode',
                data: data_json,
                beforeSend: function() {
                    $('.loading').toggleClass('d-none');
                    $('#report-submit').addClass('hide');
                },
                success: function(result) {
                    var result = JSON.parse(result);
                    if (result.message == 'success') {
                        $('#report-error').html('');
                        $('#report-container').html('<div class="btn btn-info">Mulţumim de atenţionare.</div>');
                        $('#report-success').text('Mulţumim de atenţionare.');
                    } else {
                        $('#report-submit').removeClass('hide');
                        if (result.message == 'missing') {
                            $('#report-error').text('Completează ce e necesar!');
                            $.each(result.response, function(key, value) {
                                $('#'+value).addClass('error-border');
                            });
                        } else if (result.message == 'forbiddenWords') {
                            $('#report-error').html('Exprimă-te civilizat, sunt oameni care muncesc gratis aici.');
                        } else {
                            $('#report-error').text('Eroare.');
                        }
                    }
                }
            });
        }
    });
